pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
--ghost adventure
--by retropixie

--next: 21:36

function _init()
	-- set up stuff
	px=63   --player pos x
	py=63   --player pos y
	pdx=0   --player delta x
	pdy=0   --player delta y
	s=0.5   --speed
	d=1.15  --deceleration
	pf=1    --player frame
end

function _update60()
	--thinking / logic / math
		local buttpress_h=false
	local buttpress_v=false
	
	if(btn(⬅️)) then 
		pdx=-s
		buttpress_h=true
	end
	
	if(btn(➡️)) then
	 pdx=s
	 buttpress_h=true
	end
	
	if(btn(⬆️)) then
		pdy=-s
		buttpress_v=true
	end
	
	if(btn(⬇️)) then
	 pdy=s
	 buttpress_v=true
	end
	
	if not(buttpress_h) then
		pdx/=d
	end
	
	if not(buttpress_v) then
		pdy/=d
	end
	
	px+=pdx
	py+=pdy
	
	px=mid(3,px,124)
	py=mid(3,py,124)
end

function _draw()
	--visuals go here
	cls()
	map()
	aniplr()
end
-->8
--animation--

function aniplr()
	--animate stuff
	if pf>2.95 then
		pf=1
	else
		pf+=.04
	end
	spr(pf,px,py)
end
