pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
function _init()
	px=63
	py=63
end

function _update()
	move()
end

function _draw()
	cls()
	map()
	spr(0,px,py)
end
-->8
function move()
	local lx=px
	local ly=py

	if btn(⬆️) then
		py-=1
	end
	
	if btn(⬇️) then
		py+=1
	end
	
	if btn(⬅️) then
		px-=1
	end
	
	if btn(➡️) then
		px+=1
	end
	
	if collide then
		px=lx
		py=ly
	end
end

function collide()
	mget(px/8,py/8)==3
	mget((px+7)/8,py/8)==3
	mget(px/8,(py+7)/8)==3
	mget((px+7)/8,(py+7)/8)==3
end

--px,py ⬆️⬅️ corner
--px+7,py ⬆️➡️ corner
--px,py+7 ⬇️⬅️ corner
--px+7,py+7 ⬇️➡️ corner
