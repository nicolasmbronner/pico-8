pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
--melee--

function _init()
	px=63
	py=63
	sp=1 --sprite
	pt=0 --punch timer
end

function _update()
	if btnp(❎) then
		punch()
	end
	
	if btn(➡️) then
		px+=1
	elseif btn(⬅️) then
		px-=1
	elseif btn(⬆️) then
		py-=1
	elseif btn(⬇️) then
		py+=1
	end
	
	if pt>0 then pt-=1 end
	
	if pt<=0 then
		sp=1
	end
end

function _draw()
	cls()
	map()
	spr(sp,px,py)
end
-->8
--punch--

function punch()
	pt=5
	sp=2
	
	--getting tile under fist
	--and changing it
	if mget(
	(px+7)/8,
	(py+3)/8)==3 then
		mset(
		(px+7)/8,
		(py+3)/8,4)
	end
end
