pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
function _init()
	plr={sp=1,x=64,y=64,h=50}
	cf=0 --collision flag
	score=0
	
	ipickups()
	mode=1
end

function _update60()
	if mode==1 then
		if btnp(❎) then
			score=0
			plr.h=50
			plr.x=64
			plr.y=64
			for p in all(pu) do
				p.a=true
			end
			mode=2
		end
	elseif mode==2 then
		move()
		upickups()
		if score==3 then
			mode=1
		end
	end
end

function _draw()
	if mode==1 then
		cls()
		print(
		"press ❎ to start",30,58)
	elseif mode==2 then
		cls()
		map()
		spr(plr.sp,plr.x,plr.y)
		dpickups()
	end
end
-->8
--move--

function move()
	local lx=plr.x
	local ly=plr.y
	
	if btn(⬆️) then
		plr.y-=0.5
	end
	
	if btn(⬇️) then
		plr.y+=0.5
	end
	
	if collide() then
		plr.y=ly
	end
	
	if btn(⬅️) then
		plr.x-=0.5
	end
	
	if btn(➡️) then
		plr.x+=0.5
	end
	
	if collide() then
		plr.x=lx
	end
	
	plr.x=mid(0,plr.x,120)
	plr.y=mid(0,plr.y,120)
end
-->8
--collide--

function collide()
	return
	fget(mget(plr.x/8,plr.y/8),cf) or
	fget(mget((plr.x+7)/8,plr.y/8),cf) or
	fget(mget(plr.x/8,(plr.y+7)/8),cf) or
	fget(mget((plr.x+7)/8,(plr.y+7)/8),cf)
end
-->8
--pickup--

function ipickups()
	pu={} --pickups
	
	add(pu,{sp=2,x=32,y=32,a=true})
	add(pu,{sp=2,x=96,y=56,a=true})
	add(pu,{sp=2,x=80,y=112,a=true})
end

function upickups()
	for p in all(pu) do
		if p.a and
		abs(p.x-plr.x)<5 and
		abs(p.y-plr.y)<5 then
			p.a=false
			plr.h+=10
			sfx(0)
			score+=1
		end
	end
end

function dpickups()
	for p in all(pu) do
		if p.a then
			spr(p.sp,p.x,p.y)
		end
	end
	
	print("health: "..plr.h)
end
