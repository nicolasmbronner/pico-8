pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
--gravity--

function _init()
	px=63
	py=10
	flp=false --flip player
	flf=0     --floor flag
	pux=24
	puy=56
	puf=1     --pickup flag
	pua=true  --pickup is active
end

function _update60()
	local ly=py
	
	--gravity
	py+=1
	
	if btn(⬅️) then
		px-=0.5
		flp=true
	elseif btn(➡️) then
		px+=0.5
		flp=false
	end
	
	if collide(flf) then
		py=ly
	end
	
	if collide(puf) and pua then
		pua=false
		mset(pux/8,puy/8,0)
		sfx(0)
	end
	
end

function _draw()
	cls()
	map()
	spr(1,px,py,1,1,flp)
end
-->8
--collide--

function collide(f)
	return 
	fget(mget((px+3)/8,py/8),f) or
	fget(mget((px+4)/8,py/8),f) or
	fget(mget((px+3)/8,(py+7)/8),f) or
	fget(mget((px+4)/8,(py+7)/8),f)
end
