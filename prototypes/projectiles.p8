pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
--bullets--

function _init()
	buls={}
end

function _update60()
	if btnp(❎) then
	local ry=rnd(128)
		add(buls,{
			bx=10,
			by=ry,
			bspeed=2
		})
	end
	
	for b in all(buls) do
		b.bx+=b.bspeed
		if b.bx>128 then
			del(buls,b)
		end
	end
end

function _draw()
	cls()
	print(
		"press ❎ to shoot")
	for b in all(buls) do
		spr(1,b.bx,b.by)
	end
end
