pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
--ghost adventure
--by retropixie

--next: 21:36

function _init()
	-- set up stuff
	state="start"
	putbacks={}
	setup_game()
end

function _update60()
	--thinking / logic / math
	if state=="play" then
		move_player()
	elseif state=="start" then
		if btnp(❎) then
			state="play"
		end
	elseif state=="win" then
		if btnp(❎) then
		setup_game()
			state="start"
		end
	end
end

function _draw()
	--visuals go here
	cls()
	if state=="play" then
		map()
		aniplr()
		pickups()
		draw_ui()
	elseif state=="start" then
		print("press ❎ to start",
			30,60
		)
	elseif state=="win" then
		print("you win!",
			50,60
		)
	end
end

function setup_game()
	px=63     --player pos x
	py=63     --player pos y
	pdx=0     --player delta x
	pdy=0     --player delta y
	s=0.5     --speed
	d=1.15    --deceleration
	pf=1      --player frame
	flp=false --flip sprite
	goal=6    --how many sodas?
	
	init_ui()
	
	for t in all(putbacks) do
		mset(t.x,t.y,33)
	end
	
	putbacks={}
end
-->8
--animation--

function aniplr()
	--animate stuff
	if pf>2.95 then
		pf=1
	else
		pf+=.04
	end
	-- frame,pos_x,pos_y,
	-- width,height, 
	spr(pf,px,py,1,1,flp)
end
-->8
--pickups--

function pickups()
	-- player tile x and y
	local ptx=(px+4)/8
	local pty=(py+4)/8
	
	spover=mget(ptx,pty)
	
	if spover==33 then
		mset(ptx,pty,17)
		add(putbacks,{x=ptx,y=pty})
		sodas+=1
		if sodas==goal then
			state="win"
		end
	end
end
-->8
--points/ui--

function init_ui()
	sodas=0
end

function draw_ui()
	print("sodas: "..sodas)
end
-->8
--player movement--

function move_player()
	local buttpress_h=false
	local buttpress_v=false
	
	local lx=px --last x
	local ly=py --last y
	
	if(btn(⬅️)) then 
		pdx=-s
		buttpress_h=true
		flp=false
	end
	
	if(btn(➡️)) then
		pdx=s
		buttpress_h=true
		flp=true
	end
	
	if(btn(⬆️)) then
		pdy=-s
		buttpress_v=true
	end
	
	if(btn(⬇️)) then
		pdy=s
		buttpress_v=true
	end
	
	if not(buttpress_h) then
		pdx/=d
	end
	
	if not(buttpress_v) then
		pdy/=d
	end
	
	px+=pdx
	py+=pdy
	
	px=mid(3,px,124)
	py=mid(3,py,124)
	
	--player tile x and y
	local ptx=(px+4)/8
	local pty=(py+4)/8
	
	--is the player over a tile
	--that has flag 0 ?
	if fget(
		mget(ptx,pty),0
	)==true then
		px=lx
		py=ly
	end
	
end
