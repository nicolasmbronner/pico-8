pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
function _init()
	iplr()
end

function _update60()
	uplr()
end

function _draw()
	cls()
	map()
	dplr()
end
-->8
--player--

function iplr()
	--setup our player
	
	plr={
		x=3*8,
		y=4*8,
		dx=0,    --delta x
		f=false, --flip x
		sp=1     --sprite
	}
	
	gty=1     --gravity
end

function uplr()
	--save plr x location
	local lx=plr.x
	
	--how plr responds to ctrls
	if btn(➡️) then
		plr.dx=0.8
		plr.f=false
	elseif btn(⬅️) then
		plr.dx=-0.8
		plr.f=true
	else
		plr.dx=0
	end
	
	--move player ⬅️/➡️
	plr.x+=plr.dx
	
	--if col x move back
	if collidex() then
		plr.x=lx
	end
	
	--gravity
	if not onground() then
		plr.y+=gty
	end
end

function dplr()
	--draw what the player is doing
	spr(plr.sp,plr.x,plr.y,1,1,plr.f)
	
	onground()
	print(over)
end

function onground()
	--player tile x left / right
	local ptxl=(plr.x+1)/8
	local ptxr=(plr.x+6)/8
	local pty=(plr.y+8)/8
	
	if mget(ptxl,pty)==10 or
	mget(ptxr,pty)==10 then
		return true
	else
		return false
	end
end

function collidex()
	--player tile y
	local ptxl=(plr.x+1)/8
	local ptxr=(plr.x+6)/8
	local pty=(plr.y+5)/8
	
	if mget(ptxl,pty)==10 or
	mget(ptxr,pty)==10 then
		return true
	else
		return false
	end
end
