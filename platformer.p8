pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
function _init()
	iplr() --init player
	anitimer=20
	istars()   --init stars
end

function _update60()
	uplr() --update player
	animategrass() --animate grass
	animstars() --animate stars
	uhazards() --hazards
	upickups() --pickups
end

function _draw()
	cls()
	map()
	dplr() --draw player last
end
-->8
--player--

function iplr()
	--setup our player
	
	plr={
		x=3*8, --easy placemt by tile
		y=12*8,
		dx=0,      --delta x
		f=false,   --flip x
		sp=1,      --sprite
		st="idle"  --state
	}
	
	jf=0      --jump force
	gty=1.5   --gravity
	wp=false  --button was pressed
end

function uplr()
	--save plr location
	local lx=plr.x --last x
	local ly=plr.y --last y
	
	--player moving controls
	if btn(➡️) then
		plr.dx=0.8
		plr.f=false
		plr.st="run"
		
	elseif btn(⬅️) then
		plr.dx=-0.8
		plr.f=true
		plr.st="run"
		
	else
		plr.dx=0
		plr.st="idle"
	end
	
	--jumping controls
	if btnp(🅾️) and
	chkcol(1,6,8) then
		jf=7
		wp=true
	end
	
	if wp and not btn(🅾️) then
		jf/=2
		wp=false
	end
	
	--move player ⬅️/➡️
	plr.x+=plr.dx
	
		--if col x move back
	if chkcol(0,7,5) then
		plr.x=lx
	end
	
	--vertical movement
	if jf>0 then
		plr.st="jump"
		jf-=0.5
		plr.y-=jf
	end
	
	--vertical collision
	if chkcol(1,6,8) then
		plr.y=ly
		jf=0
	else
		plr.y+=gty
		if jf <= 0 then
			plr.st="fall"
		end
	end
	
	--ceiling collision
	if chkcol(1,6,2) then
		jf=0
	end
	
	--fix intersecting w/floor
	if chkcol(1,6,7) then
		plr.y-=1
	end
	
	animate_plr()
end

function dplr()
	--draw what the player is doing
	spr(plr.sp,plr.x,plr.y,1,1,plr.f)
end

--check collision
--xlo,xro: x offset left/right
--yo: y offset
function chkcol(xlo,xro,yo)
	local ptxl=(plr.x+xlo)/8
	local ptxr=(plr.x+xro)/8
	local pty=(plr.y+yo)/8
	
	return mget(ptxl,pty)==10 or
	       mget(ptxr,pty)==10 or
	       mget(ptxl,pty)==26 or
	       mget(ptxr,pty)==26
end
-->8
--animation--

function animate_plr()
	
	--handle animation state
	
	--idle
	if plr.st=="idle" then
		if plr.sp<2.9 then
			plr.sp+=.02
		else
			plr.sp=1
		end
	
	--run
	elseif plr.st=="run" then
		if plr.sp<6.7 then
			plr.sp+=.15
		else
			plr.sp=3
		end
	
	--jump
	elseif plr.st=="jump" then
		plr.sp=7
	
	--fall
	elseif plr.st=="fall" then
		plr.sp=18
	end
end

function animategrass()
	if anitimer<=0 then
		for x=0,15 do
			for y=0,15 do
				if mget(x,y)==28 then
					mset(x,y,29)
				elseif mget(x,y)==29 then
					mset(x,y,28)
				end
			end --for y
		end --for x
		anitimer=20
	else
		anitimer-=1
	end
end
-->8
--interractables--

function upickups()
	local ptx=(plr.x+4)/8
	local pty=(plr.y+5)/8
	
	if mget(ptx,pty)==8 then
		mset(ptx,pty,16)
	end
end
-->8
--danger--

function uhazards()
	local ptx=(plr.x+4)/8
	local pty=(plr.y+5)/8
	
	if mget(ptx,pty)==23 or
	mget(ptx,pty)==24 or
	mget(ptx,pty)==25 then
		plr.sp=19
	end
end
-->8
--stars--

--initiate stars
function istars()
	★={
		fr={35,36,37},  --frames
		mf=35,          --main frame
		curf=1,        --current frame
		tmr=15,         --timer
		
		--main frame multiplier
		mmin=2,         --min
		mmax=15,        --max
		
		dir=1           --direction
	},
	{
		fr={51,52,53},
		mf=51,
		curf=1,
		tmr=30,
		mmin=10,
		mmax=40,
		dir=1
	}
	
	--store inividual state of
	--each ★ on the map
	★st={}
	
	--scan map + init each ★
	for x=0,15 do
		for y=0,15 do
			local mt=mget(x,y) --map tile
			for typ=1,#★ do --★ types
				for fr in all(★[typ].fr) do
					if mt==fr then
						--next
					end
				end --fr in all(★[typ].fr
			end --for ★typ
		end --for y
	end --for x
end

--animate stars
function animstars()
	
end

