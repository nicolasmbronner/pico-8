pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
-- lost in the woods
-- by retropixie

-- === idees ===
-- trouver du bois a bruler
-- cache cache
-- extra:trouver cle pour ouvrir
-- porte fermee > bois

function _init()
	w=3     --wood
	pb={}   --put backs (interact.)
	st="start" --state
	iplr() --init player
	
	anitimer=20
	i★()   --init stars
	
	deb={}
	ienemies()
	ipickups()
end

function _update60()
	
	if st=="play" then
		uplr() --update player
		animategrass() --animate grass
		uhazards() --hazards
		uenemies() --enemies
		upickups() --pickups
		u★() --animate stars
		uhouse()   --house > win
	elseif st=="dead" then
		--todo:no back to title
		uplr()
		animategrass()
		uhazards()
		uenemies()
		upickups()
		u★()
		uhouse()
		if btnp(🅾️) then
			--plr.x=3*8
			--plr.y=12*8
			st="play"
			respawn()
		end
		plr.sp=19
	elseif st=="start" then
		if btnp(🅾️) then
			st="play"
		end
	elseif st=="win" then
		if btnp(🅾️) then
			plr.x=3*8
			plr.y=12*8
			st="play"
			respawn()
		end
	end
end

function _draw()
	cls()
	map()
	denemies() --draw enemies
	dplr() --draw player last
	if st=="dead" then
		rectfill(38,58,88,66,1)
		print("you are dead",40,60,7)
	elseif st=="start" then
		rectfill(38,58,88,66,1)
		print("press 🅾️",48,60,7)
	elseif st=="win" then
		rectfill(38,58,88,66,1)
		print("you win!",48,60,7)
	end
end
-->8
--player--

function iplr()
	--setup our player
	
	plr={
		x=3*8, --easy placemt by tile
		y=12*8,
		dx=0,      --delta x
		f=false,   --flip x
		sp=1,      --sprite
		st="idle"  --state
	}
	
	jf=0      --jump force
	gty=1.5   --gravity
	wp=false  --button was pressed
end --iplr()

function uplr()
	--save plr location
	local lx=plr.x --last x
	local ly=plr.y --last y
	
	--player moving controls
	if btn(➡️) and
	st=="play" then
		plr.dx=0.8
		plr.f=false
		plr.st="run"
		
	elseif btn(⬅️) and
	st=="play" then
		plr.dx=-0.8
		plr.f=true
		plr.st="run"
		
	else
		plr.dx=0
		plr.st="idle"
	end
	
	--jumping controls
	if btnp(🅾️) and
	chkcol(1,6,8) and
	st=="play" then
		jf=7
		wp=true
	end
	
	if wp and not btn(🅾️) then
		jf/=2
		wp=false
	end
	
	--move player ⬅️/➡️
	plr.x+=plr.dx
	
		--if col x move back
	if chkcol(0,7,5) then
		plr.x=lx
	end
	
	--vertical movement
	if jf>0 then
		plr.st="jump"
		jf-=0.5
		plr.y-=jf
	end
	
	--vertical collision
	if chkcol(1,6,8) then
		plr.y=ly
		jf=0
	else
		plr.y+=gty
		if jf <= 0 then
			plr.st="fall"
		end
	end
	
	--ceiling collision
	if chkcol(1,6,2) then
		jf=0
	end
	
	--fix intersecting w/floor
	if chkcol(1,6,7) then
		plr.y-=1
	end
	
	plr.x=mid(0,plr.x,120)
	plr.y=mid(0,plr.y,120)
	
	animate_plr()
end --uplr()

function dplr()
	--draw what the player is doing
	spr(plr.sp,plr.x,plr.y,1,1,plr.f)
end --dplr()

--check collision
--xlo,xro: x offset left/right
--yo: y offset
function chkcol(xlo,xro,yo)
	local ptxl=(plr.x+xlo)/8
	local ptxr=(plr.x+xro)/8
	local pty=(plr.y+yo)/8
	
	return mget(ptxl,pty)==10 or
	       mget(ptxr,pty)==10 or
	       mget(ptxl,pty)==26 or
	       mget(ptxr,pty)==26
end --chkcol()
-->8
--animation--

function animate_plr()
	
	--handle animation state
	
	--idle
	if plr.st=="idle" then
		if plr.sp<2.9 then
			plr.sp+=.02
		else
			plr.sp=1
		end
	
	--run
	elseif plr.st=="run" then
		if plr.sp<6.7 then
			plr.sp+=.15
		else
			plr.sp=3
		end
	
	--jump
	elseif plr.st=="jump" then
		plr.sp=7
	
	--fall
	elseif plr.st=="fall" then
		plr.sp=18
	end
end

function animategrass()
	if anitimer<=0 then
		for x=0,15 do
			for y=0,15 do
				if mget(x,y)==28 then
					mset(x,y,29)
				elseif mget(x,y)==29 then
					mset(x,y,28)
				end
			end --for y
		end --for x
		anitimer=20
	else
		anitimer-=1
	end
end
-->8
--interractables--

function ipickups()
	for x=0,15 do
		for y=0,15 do
			if mget(x,y)==8 then
				add(pb,{
					tx=x,
					ty=y,
					sp=8
				})
			end
		end --for y
	end ---for x
end

function upickups()
	local ptx=(plr.x+4)/8
	local pty=(plr.y+5)/8
	
	if mget(ptx,pty)==8 then
		mset(ptx,pty,16)
		w-=1
	end
end

function uhouse()
	local ptx=(plr.x+4)/8
	local pty=(plr.y+5)/8
	
	if mget(ptx,pty)==49 and
	w==0 then
		st="win"
	end
end
-->8
--danger--

--enemies--
function ienemies()
	en={ --enemies boundaries
		{ --top enemy
			l=(9*8)-3,
			r=(12*8)+3
		},
		{ --bottom enemy
			l=13*8,
			r=15*8
		}
	}
	
	ens={}        --enemies table
	local encnt=0 --enemy counter
	
	--loop map to find enemies
	for x=0,15 do
		for y=0,15 do
			local mt=mget(x,y) --map tile
			if mt==41 then
				
				add(pb,{
					tx=x,
					ty=y,
					sp=41
				})
				
				mset(x,y,0) --delete tile
				encnt+=1
				
				--add enemy data
				add(ens,{
					ex=x*8, --position x
					ey=y*8, 
					sp=41,
					f=true,    --flip
					dx=-1,     --direction on x
					l=en[encnt].l, --⬅️ limit
					r=en[encnt].r  --➡️ limit
				})
			end
		end
	end
end --ienemies()

function uenemies()
	for e in all(ens) do
		
		--move back and forth
		if e.ex<=e.l or e.ex>=e.r then
			e.dx=e.dx*-1
		end
		
		e.ex+=e.dx*.3 --add direction
		
		-- animate enemies
		if e.sp<44.7 then
			e.sp+=.07
		else
			e.sp=41
		end
		
		-- flip enemies
		if e.dx>0 then
			e.f=true
		else
			e.f=false
		end
		
		--test if touching plr
		if abs(plr.x-e.ex)<4 and
		   abs(plr.y-e.ey)<4 then
			plr.sp=19
			st="dead"
		end
		
	end --for e in all(en)
end --uenemies()

function denemies()
	for e in all(ens) do
		spr(e.sp,e.ex,e.ey,1,1,e.f)
	end
end --denemies()


--hazards--
function uhazards()
	local ptx=(plr.x+4)/8
	local pty=(plr.y+5)/8
	
	-- test if touch player
	if mget(ptx,pty)==23 or
	mget(ptx,pty)==24 or
	mget(ptx,pty)==25 then
		plr.sp=20
		st="dead"
	end
end
-->8
--stars--

--create star state
--(star config,star type)
function crea★st(sc,st)
	return {
		--current timer
		ctmr=sc.tmr*rand(
		sc.mmin,sc.mmax),
		curf=sc.curf, --current frame
		dir=sc.dir, --direction
		--main frame multiplier
		mfrm=rand(sc.mmin,sc.mmax),
		typ=st
	}
end

--random multiplier generator
function rand(mmin,mmax)
	return flr(rnd(
	mmax-mmin+1))+mmin
end

--initiate stars
function i★()
	★={
		{ --big star
			fr={35,36,37},--frames
			mf=35,        --main frame
			curf=1,       --current frame
			tmr=15,       --timer
			
			--main frame multiplier
			mmin=2,       --min
			mmax=30,      --max
			
			dir=1         --direction
		},
		{ --huge star
			fr={51,52,53},
			mf=51,
			curf=1,
			tmr=20,
			mmin=10,
			mmax=30,
			dir=1
		},
		{ --micro star
			fr={38,39},
			mf=38,
			curf=1,
			tmr=20,
			mmin=2,
			mmax=10,
			dir=1
		},
		{ --little star
			fr={54,55,56},
			mf=54,
			curf=1,
			tmr=10,
			mmin=4,
			mmax=20,
			dir=1
		}
	}
	
	--store inividual state of
	--each ★ on the map
	★st={}
	
	--scan map + init each ★:
	for x=0,15 do
		for y=0,15 do
			local mt=mget(x,y) --map tile
			for typ=1,#★ do --★ types
				if mt==★[typ].mf then
					★st[x..","..y]=
					crea★st(★[typ],typ)
					break
				end --if mt==★[typ].mf
			end --for (all ★ types)
		end --for y
	end --for x
end

--animate stars
function u★()
	for k,st in pairs(★st) do
		
		if st.ctmr <=0 then
			--calculate next frame
			local nf=st.curf+st.dir
			
			--check limits + invert dir
			if nf>#★[st.typ].fr then
				nf=#★[st.typ].fr -1
				st.dir=-1
			elseif nf<1 then
				nf=2
				st.dir=1
			end
			
			--save new frame
			st.curf=nf
			
			--extract x,y from key "x,y"
			local c=0 --comma
			for i=1,#k do
				if sub(k,i,i)=="," then
					c=i
					break
				end --if sub(k,i,i)==","
			end --for i=1,#k
			
			--+0 to convert in number
			local x=sub(k,1,c-1)+0
			local y=sub(k,c+1)+0
			
			--get new tile, apply to map
			local nt=★[st.typ].fr[nf]
			mset(x,y,nt)
			
			--reset timer
			if nt==★[st.typ].mf then
				--main frame:regenerate
				--multiplier and use it
				st.mfrm=rand(
				★[st.typ].mmin,
				★[st.typ].mmax)
				
				st.ctmr=
				★[st.typ].tmr*st.mfrm
			else --if nt==★[st.typ].mf
				--other frames:base timer
				st.ctmr=★[st.typ].tmr
			end
			
		else --if st.ctmr <=0
			--only increment timer
			st.ctmr-=1
		end --else
	end --for k,st in pairs (★st)
end
-->8
--respawn--

function respawn()
	for t in all(pb) do
		mset(t.tx,t.ty,t.sp)
		del(pb,t)
	end
	_init()
end
