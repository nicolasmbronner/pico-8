pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
function _init()
	inv={"axe","bone","knife"}
	plr={x=4,y=6,h=75}
	en={x=12,y=14,h=35}
end

function _update()
	
end

function _draw()
	cls()
	print(inv[2]) --bone
	print(plr.y)  --6
	
	--compare plr.x with en.x
	local diff=abs(plr.x-en.x)
	print("diff:"..diff) --8
	
	--loop print inventory
	for f in all(inv) do
		print(f) --axe bone knife
	end
end
