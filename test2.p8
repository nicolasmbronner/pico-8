pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
function _init()
	pt=1   --player tile
	px=63  --player x pos
	py=50  --player y pos
	health=100
	
	ipickups()
end

function _update60()
	move()
	upickups()
end

function _draw()
	cls()
	spr(pt,px,py)
	dpickups()
end
-->8
--move/collision--

function move()
	local lx=px
	local ly=py
	
	if btn(⬆️) then
		py-=0.75
	elseif btn(⬇️) then
		py+=0.75
	elseif btn(➡️) then
		px+=0.75
	elseif btn(⬅️) then
		px-=0.75
	end
end
-->8
--pickups--

function ipickups()
	put=2    --pickup tile
	pux=32   --pickup x pos
	puy=56   --pickup y pos
	pua=true --pickup is active
end

function upickups()
	if abs(pux-px)<5 and
	abs(puy-py)<5 and pua then
		pua=false
		health+=100
	end
end

function dpickups()
	if pua then
		spr(put,32,56)
	end
	print("health: "..health)
end
