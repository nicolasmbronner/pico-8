pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
function _init()
	px=30      --player x pos
	py=30      --player y pos
	pm=""      --player moving dir
	flpx=false --flip x
	flpy=false --flip y
	
	--horizontal animation
	hf=1       --current hor frame
	hd=1       --hor anim dir
	hmn=1      --min hor frame
	hmx=4.45   --max hor frame
	
	--vertical animation
	vf=1       --curr vert frame
	vd=1       --vert anim dir
	vmn=1      --min vert frame
	vmx=20     --max vert frame
	-- vertical animation seq
	vmidf={18,19,20,19,18}
	vi=1       --vert seq index
	
	cf=1       --current frame
	im=false   --is moving
end

function _update60()
	im=false
	pm=""
	
	if btn(⬅️) then 
		px-=1
		pm="⬅️"
		flpx=true
		im=true
	elseif btn(➡️) then
		px+=1
		pm="➡️"
		flpx=false
		im=true
	elseif btn(⬆️) then 
		py-=1
		pm="⬆️"
		flpy=false
		im=true
	elseif btn(⬇️) then 
		py+=1 
		pm="⬇️"
		flpy=true
		im=true
	end
	
	--horizontal animation (⬅️/➡️)
	if im and (pm=="⬅️" or
	pm=="➡️") then
		if hd==1 then
			hf+=.1
			if hf>=hmx then
				hd=2
			end
		else
			hf-=.1
			if hf<=hmn then
				hd=1
			end
		end
		cf=flr(hf)
	end
	
	--vertial animation (⬆️/⬇️)
	if im and (pm=="⬆️" or
	pm=="⬇️") then
		if vd==1 then
			vi+=.1
			if vi>=5 then
				vd=2
				vi=5
			end
		else
			vi-=.1
			if vi<=1 then
				vd=1
				vi=1
			end
		end
		
		--obtain frame from seq
		local idx=flr(vi)
		if idx<1 then idx=1 end
		if idx>5 then idx=5 end
		
		if idx==1 then
			cf=1
		else
			cf=vmidf[idx]
		end
	end
	
	
	px=mid(0,px,120)
	py=mid(0,py,120)
end

function _draw()
	--anim player (if moving)
	cls()
	
	spr(cf,px,py,1,1,flpx,flpy)
end
