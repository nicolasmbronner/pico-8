pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
function _init()
	iplr()
end

function _update60()
	uplr()
end

function _draw()
	cls()
	map()
	dplr()
end
-->8
--player--

function iplr()
	p={
		x=8*8,
		y=8*8,
		dx=1,
		dy=0,
		fr=1,     --frame
		fl=false  --flipped
	}
	
	grvt=1     --gravity
end

function uplr()
	local lx=p.x
	local ly=p.y
	
	if btn(➡️) then
		p.x+=p.dx
		p.fl=false
	elseif btn(⬅️) then
		p.x-=p.dx
		p.fl=true
	end
	
	if btnp(❎) and grounded() then
		p.dy=8
	end
	
	if p.dy>0 then
		p.dy-=1
	end
	
	p.y-=p.dy
	
	if not grounded() then
		p.y+=grvt
	else
		p.y=ly
	end
	
	if collision() then
		p.x=lx
	end
end

function grounded()
	return
		mget(p.x/8,(p.y+8)/8)==2 or
		mget((p.x+7)/8,(p.y+8)/8)==2
end

function collision()
	return
	mget((p.x+2)/8,(p.y+1)/8)==2 or
	mget((p.x+6)/8,(p.y+1)/8)==2 or
	mget((p.x+2)/8,(p.y+7)/8)==2 or
	mget((p.x+6)/8,(p.y+7)/8)==2
end

function dplr()
	spr(p.fr,p.x,p.y,1,1,p.fl)
end
