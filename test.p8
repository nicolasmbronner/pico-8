pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
function _init()
	px=30      --player x pos
	py=30      --player y pos
	psf=1      --player start frame
	pef=4.99   --player end frame
	pf=1       --player frame
	pm=""      --player moving dir
	flpx=false --flip x
	flpy=false --flip y
	fd=1       --frame direction
end

function _update60()
	pm=false
	
	if btn(⬅️) then 
		px-=1
		pm="⬅️"
		flpx=true
	elseif btn(➡️) then
		px+=1
		pm="➡️"
		flpx=false
	elseif btn(⬆️) then 
		py-=1
		pm="⬆️"
		flpy=false
	elseif btn(⬇️) then 
		py+=1 
		pm="⬇️"
		flpy=true
	end
	
	px=mid(0,px,120)
	py=mid(0,py,120)
end

function _draw()
	--anim player (if moving)
	cls()
	
	if fd==1 then
		if pf>=4.45 then
			fd=2
			pf-=.2
		else
			pf+=.2
		end
	else
		if pf<=1.15 then
			fd=1
			pf+=.2
		else
			pf-=.2
		end
	end
	
	spr(pf,px,py,1,1,flpx,flpy)
end
