pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
function _init()
	x=55
	y=55
end

function _update60()
	if btn(⬆️) then
		y-=1
	elseif btn(⬇️) then
		y+=1
	elseif btn(➡️) then
		x+=1
	elseif btn(⬅️) then
		x-=1
	end
end

function _draw()
	cls()
	spr(1,x,y)
end
