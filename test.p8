pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
function _init()
	init_player()
end

function _update60()
	update_player()
end

function _draw()
	cls(1)
	map()
	draw_player()
end
-->8
-- player --

function init_player()
	plr={
		sp=1,
		x=64,
		y=64,
		s=1,
		dx=0,
		dy=0
	}
	
	wsp=2
end

function update_player()
	local lx=plr.x
	local ly=plr.y
	plr.dx=0
	plr.dy=0
	
	if btn(⬆️) then
		plr.dy-=plr.s
	end
	if btn(⬇️) then
		plr.dy+=plr.s
	end
	
	plr.y+=plr.dy
	
	if check_col(wsp) then
		plr.y=ly
	end
	
	if btn(⬅️) then
		plr.dx-=plr.s
	end
	if btn(➡️) then
		plr.dx+=plr.s
	end
	
	plr.x+=plr.dx
	
	if check_col(wsp) then
		plr.x=lx
	end
	
	plr.x=mid(0,plr.x,120)
	plr.y=mid(0,plr.y,120)
end

function draw_player()
	spr(plr.sp,plr.x,plr.y)
end
-->8
-- collisions --

function check_col(sp)
	local x=plr.x
	local y=plr.y
	
	return
	mget(x/8,y/8)==sp or
	mget((x+7)/8,y/8)==sp or
	mget(x/8,(y+7)/8)==sp or
	mget((x+7)/8,(y+7)/8)==sp
end
