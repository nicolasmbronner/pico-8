pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
function _init()
	plr={sp=1,x=64,y=64,h=70}
	cf=0 --collision flag
	
	ipickups()
end

function _update60()
	move()
	upickups()
end

function _draw()
	cls()
	map()
	spr(plr.sp,plr.x,plr.y)
	dpickups()
end
-->8
--move--

function move()
	local lx=plr.x
	local ly=plr.y
	
	if btn(⬆️) then
		plr.y-=0.5
	end
	
	if btn(⬇️) then
		plr.y+=0.5
	end
	
	if collide() then
		plr.y=ly
	end
	
	if btn(⬅️) then
		plr.x-=0.5
	end
	
	if btn(➡️) then
		plr.x+=0.5
	end
	
	if collide() then
		plr.x=lx
	end
	
	plr.x=mid(0,plr.x,120)
	plr.y=mid(0,plr.y,120)
end
-->8
--collide--

function collide()
	return
	fget(mget(plr.x/8,plr.y/8),cf) or
	fget(mget((plr.x+7)/8,plr.y/8),cf) or
	fget(mget(plr.x/8,(plr.y+7)/8),cf) or
	fget(mget((plr.x+7)/8,(plr.y+7)/8),cf)
end
-->8
--pickup--

function ipickups()
	pu={sp=2,x=32,y=32,a=true}
end

function upickups()
	if abs(pu.x-plr.x)<5 and
	abs(pu.y-plr.y)<5 and pu.a then
		pu.a=false
		plr.h+=30
		sfx(0)
	end
end

function dpickups()
	if pu.a then
			spr(pu.sp,pu.x,pu.y)
	end
	print("health: "..plr.h)
end
