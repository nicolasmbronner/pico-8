pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
function _init()
	pt=1   --player tile
	ph=75  --player health
	px=64
	py=64
	cf=0   --collision flag
	
	ipickups()
end

function _update60()
	move()
	upickups()
end

function _draw()
	cls()
	map()
	move()
	
	palt(0,false) --black=opaque
	palt(7,true)  --white=transp
	spr(pt,px,py)
	pal()
	
	dpickups()
end
-->8
--player movement--

function move()
	local lx=px
	local ly=py
	
	if btn(⬆️) then
		py-=0.5
	end
	
	if btn(⬇️) then
		py+=0.5
	end
	
	if collide() then
		py=ly
	end
	
	if btn(⬅️) then
		px-=0.5
	end
	
	if btn(➡️) then
		px+=0.5
	end
	
	if collide() then
		px=lx
	end
	
	px=mid(0,px,120)
	py=mid(0,py,120)
end
-->8
--player collision--

function collide()
	return
		fget(mget(px/8,py/8),cf) or
		fget(mget((px+7)/8,py/8),cf) or
		fget(mget(px/8,(py+7)/8),cf) or
		fget(mget((px+7)/8,(py+7)/8),cf)
end
-->8
--pickups--

function ipickups()
	put=2     --pickup tile
	pux=32    --pickup pos
	puy=24
	pua=true --pickup active
end

function upickups()
	if pua and
	abs(pux-px)<8 and
	abs(puy-py)<8 then
		pua=false
		ph+=25
		sfx(0)
	end
end

function dpickups()
	if pua then
		spr(put,pux,puy)
	end
	print(ph)
end
